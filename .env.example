# ========================================================
# ElevateAI / Cadence Environment Variables Template
# ========================================================

# OpenAI-Compatible API Key & Endpoint
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=

# Optional observability. Interviews continue normally when these are unset.
LANGSMITH_API_KEY=
LANGSMITH_TRACING=false
LANGSMITH_PROJECT=cadence
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# Next.js Node Environment
NODE_ENV=development
